PORT=4000

# Option A: single connection string (simplest for local dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/task_assignment

# Option B: discrete vars (used automatically by node-postgres if DATABASE_URL
# is unset). This is what docker-compose.yml uses in combination with
# PGPASSWORD_FILE pointing at a Docker secret, instead of a plaintext password.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=task_assignment

# Optional. If unset, a keyword-based fallback classifier is used instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
